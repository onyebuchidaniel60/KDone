# KDone environment variables. Copy to `.env.local` for local dev.
# NEVER commit real values. Nothing here is secret except the marked items.

# ---------------------------------------------------------------- shared (both services)
# Required. PostgreSQL connection string. Neon pooled endpoints must omit
# channel_binding, and prepared statements are auto-disabled for *-pooler hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Required for production. Generate with: openssl rand -base64 32
# SECRET - never commit a real value.
AUTH_SECRET=

# Public. Vercel/Render need this to build the correct auth callback URLs,
# e.g. https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# Public. Required when behind a proxy/host such as Vercel.
AUTH_TRUST_HOST=true

# Public. Set in all three environments; must match the deployed URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- queue
# Set ONLY where the worker runs. When unset the process falls back to
# InMemoryQueue (jobs only execute in-process - single instance only).
QUEUE_DRIVER=bullmq

# Required by the Render worker AND by Vercel if the web app should enqueue to
# the same Redis. MUST be byte-identical in both services or jobs are enqueued
# to one Redis while the worker listens to another, and nothing fails loudly.
REDIS_URL=rediss://default:TOKEN@HOST:PORT

# ---------------------------------------------------------------- web only
# Must be false/absent in production. When true (non-production only) the
# Credentials provider is enabled. Credentials are always bcrypt-verified.
AUTH_DEV_LOGIN=true

# ---------------------------------------------------------------- storage
# Cloudflare R2 (S3-compatible). When all four are set, S3StorageProvider is
# used; otherwise the in-process MockStorageProvider is used (tests/local dev).
# R2 requires path-style addressing, which the provider forces.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# SECRET - never commit a real value.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- platform
# Managed by the platform. Do not set manually.
NODE_ENV=production
