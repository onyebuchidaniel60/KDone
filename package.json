{
    "name":  "kdone",
    "private":  true,
    "version":  "0.1.0",
    "packageManager":  "pnpm@10.34.5",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "turbo run build",
                    "typecheck":  "turbo run typecheck",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:e2e":  "vitest run --config vitest.e2e.config.ts",
                    "db:generate":  "pnpm --filter @kdone/db generate",
                    "db:migrate":  "pnpm --filter @kdone/db migrate",
                    "compose:up":  "docker compose up -d",
                    "compose:down":  "docker compose down",
                    "test:repro":  "vitest run --config vitest.repro.config.ts",
                    "test:browser":  "playwright test"
                },
    "devDependencies":  {
                            "@kdone/agents":  "workspace:*",
                            "@kdone/ai":  "workspace:*",
                            "@kdone/db":  "workspace:*",
                            "@kdone/epub":  "workspace:*",
                            "@kdone/jobs":  "workspace:*",
                            "@kdone/publishing":  "workspace:*",
                            "@kdone/shared":  "workspace:*",
                            "@kdone/storage":  "workspace:*",
                            "@kdone/validation":  "workspace:*",
                            "@playwright/test":  "^1.63.0",
                            "@types/node":  "^22.10.2",
                            "drizzle-orm":  "^0.38.3",
                            "turbo":  "^2.3.3",
                            "typescript":  "^5.7.2",
                            "vitest":  "^2.1.8",
                            "next":  "^15.1.3"
                        },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "esbuild"
                                           ]
             },
    "_comment":  "next is a devDependency HERE ON PURPOSE. Vercel detects the framework from the ROOT package.json; next lives in apps/web. Without this entry, \u0027vercel --prod\u0027 fails with \u0027No Next.js version detected\u0027. Do not remove it, and do not set rootDirectory in vercel.json (the build runs turbo from the repo root and outputs to apps/web/.next)."
}