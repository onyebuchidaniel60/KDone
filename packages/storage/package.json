{
    "name":  "@kdone/storage",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "default":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test:integration":  "vitest run src/s3-storage.integration.test.ts"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1152.0",
                         "@kdone/shared":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.10.2",
                            "typescript":  "^5.7.2",
                            "vitest":  "^2.1.8"
                        }
}