{
  "name": "@kdone/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./test-db": {
      "types": "./dist/test-db.d.ts",
      "default": "./dist/test-db.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@kdone/shared": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}